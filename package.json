{
  "name": "@ibitsuki0296/md-book",
  "version": "0.2.0",
  "description": "Runtime-first Markdown documentation & blog site library with token-based theming, static build, search, math/diagrams and i18n",
  "type": "module",
  "license": "MIT",
  "author": "Hazuki ABE",
  "homepage": "https://github.com/ibitsuki0296/md-book#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibitsuki0296/md-book.git"
  },
  "bugs": {
    "url": "https://github.com/ibitsuki0296/md-book/issues"
  },
  "keywords": [
    "markdown",
    "documentation",
    "blog",
    "static-site",
    "docs",
    "theme",
    "web-component",
    "ssg",
    "search",
    "i18n",
    "katex",
    "mermaid"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "md-book": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.mjs",
      "require": "./dist/astro.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    },
    "./style.css": "./dist/style.css",
    "./themes/*": "./dist/themes/*"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "size": "size-limit",
    "version": "changeset version && node scripts/sync-version.mjs && biome format --write package.json",
    "release": "npm run build && changeset publish",
    "prepare": "lefthook install || true",
    "example": "npm run build && cp dist/md-book.global.js dist/style.css examples/docs/ && node dist/cli.mjs dev --root examples/docs --content examples/docs/content --locales en,ja --port 4173",
    "playground": "npm run build && cp dist/md-book.global.js dist/style.css examples/playground/ && node dist/cli.mjs dev --root examples/playground --content examples/docs/content --locales en,ja --port 4180"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "@size-limit/file": "^11.1.6",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "happy-dom": "^20.11.15",
    "lefthook": "^1.10.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
